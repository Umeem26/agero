# Agero frontend chain config. Copy to .env.local to override; every value has the same
# Testnet default built into src/chain/config.js (docs/deploy.md section 6).
# These values are public. Never put a secret key or seed phrase in any VITE_* variable:
# Vite inlines them into the browser bundle.

# Agero escrow contract v2 on Testnet
VITE_CONTRACT_ID=CA5CMRJJHCJZIKVGFIOEV3BGVNTQVOI6KYV4S3GOROHUS7HLUUYLBDFB
# Soroban RPC endpoint (Testnet)
VITE_RPC_URL=https://soroban-testnet.stellar.org
# Must match the network selected in Freighter
VITE_NETWORK_PASSPHRASE=Test SDF Network ; September 2015
# Native XLM Stellar Asset Contract (stellar contract id asset --asset native --network testnet)
VITE_XLM_SAC=CDLZFC3SYJYDZT7K67VZ75HPJVIEUVNIXF47ZG2FB2RMQQVU2HHGCYSC
# Block explorer used for transaction and contract links
VITE_EXPLORER_URL=https://stellar.expert/explorer/testnet
